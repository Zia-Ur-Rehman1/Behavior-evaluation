<%#
  MCP Floating Chat Widget — generated by extendable-rails
  =========================================================
  Drop into app/views/layouts/application.html.erb just before </body>:

    <%%= render "mcp/chat_widget" %>

  The widget auto-loads the MCP system prompt and tool list.
  Customise the greeting via Rails.application.config.mcp_chat_greeting
  or the MCP_CHAT_GREETING env var.
-%>

<%% greeting = defined?(Rails) && Rails.application.config.respond_to?(:mcp_chat_greeting) &&
               Rails.application.config.mcp_chat_greeting.present? ?
               Rails.application.config.mcp_chat_greeting :
               (ENV["MCP_CHAT_GREETING"] || "Hi! I'm your AI assistant. I can help you manage records in this app. Try asking me to list, create, update, or delete items.") %>

<%# ── Scoped styles ── %>
<style>
  .mcp-fab{position:fixed;bottom:1.5rem;right:1.5rem;width:3.25rem;height:3.25rem;border-radius:50%;background:#3b82f6;color:#fff;border:none;cursor:pointer;box-shadow:0 4px 14px rgba(59,130,246,.5);display:flex;align-items:center;justify-content:center;z-index:9998;transition:transform .15s,box-shadow .15s;}
  .mcp-fab:hover{transform:scale(1.08);box-shadow:0 6px 20px rgba(59,130,246,.55);}
  .mcp-fab svg{width:1.4rem;height:1.4rem;}
  .mcp-panel{position:fixed;bottom:5.5rem;right:1.5rem;width:360px;max-height:560px;border-radius:1rem;background:#fff;box-shadow:0 8px 32px rgba(0,0,0,.18);display:flex;flex-direction:column;z-index:9999;overflow:hidden;transform:scale(.85) translateY(12px);opacity:0;pointer-events:none;transition:transform .2s cubic-bezier(.34,1.56,.64,1),opacity .18s ease;}
  .mcp-panel.mcp-open{transform:scale(1) translateY(0);opacity:1;pointer-events:all;}
  .mcp-panel__header{background:#3b82f6;color:#fff;padding:.75rem 1rem;display:flex;align-items:center;gap:.6rem;flex-shrink:0;}
  .mcp-panel__header h3{margin:0;font-size:.95rem;font-weight:600;flex:1;}
  .mcp-panel__close{background:none;border:none;color:#fff;cursor:pointer;font-size:1.25rem;line-height:1;padding:0;opacity:.8;}
  .mcp-panel__close:hover{opacity:1;}
  .mcp-panel__body{flex:1;overflow-y:auto;padding:.75rem;display:flex;flex-direction:column;gap:.5rem;}
  .mcp-msg{display:flex;align-items:flex-end;gap:.4rem;}
  .mcp-msg--user{flex-direction:row-reverse;}
  .mcp-msg__avatar{width:1.75rem;height:1.75rem;border-radius:50%;background:#e0e7ff;color:#3730a3;font-size:.65rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .mcp-msg__bubble{max-width:78%;padding:.45rem .75rem;border-radius:1rem;font-size:.85rem;line-height:1.45;border:1px solid transparent;}
  .mcp-msg--user .mcp-msg__bubble{background:#3b82f6;color:#fff;border-radius:1rem 1rem 0 1rem;}
  .mcp-msg--assistant .mcp-msg__bubble{background:#f3f4f6;color:#111827;border-radius:1rem 1rem 1rem 0;border-color:#e5e7eb;}
  .mcp-msg--error .mcp-msg__bubble{background:#fef2f2;color:#b91c1c;border-color:#fecaca;border-radius:1rem;}
  .mcp-msg__bubble p{margin:.2rem 0;}
  .mcp-panel__context{padding:.4rem .75rem;background:#f9fafb;border-top:1px solid #f3f4f6;flex-shrink:0;font-size:.75rem;}
  .mcp-panel__footer{padding:.6rem .75rem;border-top:1px solid #e5e7eb;flex-shrink:0;}
  .mcp-panel__form{display:flex;gap:.5rem;align-items:center;}
  .mcp-panel__send{background:#3b82f6;color:#fff;border:none;border-radius:50%;width:2rem;height:2rem;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background .1s;}
  .mcp-panel__send:hover{background:#2563eb;}
  .mcp-panel__send svg{width:1rem;height:1rem;}
  .mcp-typing{display:flex;gap:.3rem;padding:.35rem .6rem;align-items:center;}
  .mcp-typing span{width:.45rem;height:.45rem;background:#9ca3af;border-radius:50%;animation:mcpBounce .9s infinite;}
  .mcp-typing span:nth-child(2){animation-delay:.15s;}
  .mcp-typing span:nth-child(3){animation-delay:.3s;}
  @keyframes mcpBounce{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-.45rem)}}
  @media(max-width:420px){.mcp-panel{width:calc(100vw - 2rem);right:1rem;}}
</style>

<%# ── Toggle button ── %>
<button id="mcp-fab" class="mcp-fab" aria-label="Open AI chat" title="Chat with AI assistant"
        onclick="document.getElementById('mcp-panel').classList.toggle('mcp-open'); document.getElementById('mcp-chat-input')?.focus();">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
  </svg>
</button>

<%# ── Chat panel ── %>
<div id="mcp-panel" class="mcp-panel" role="dialog" aria-modal="true" aria-label="AI Chat">

  <%# Header %>
  <div class="mcp-panel__header">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:1.1rem;height:1.1rem;flex-shrink:0;">
      <circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/>
    </svg>
    <h3>AI Assistant</h3>
    <%%= button_to "Clear", clear_mcp_chats_path, method: :delete,
          form: { data: { turbo_confirm: "Clear chat history?" } },
          style: "background:rgba(255,255,255,.2);border:none;border-radius:0.375rem;color:#fff;cursor:pointer;font-size:0.7rem;padding:0.2rem 0.5rem;margin-right:0.25rem;" %>
    <button class="mcp-panel__close" aria-label="Close"
            onclick="document.getElementById('mcp-panel').classList.remove('mcp-open')">&#x2715;</button>
  </div>

  <%# Message list %>
  <div id="mcp-chat-messages" class="mcp-panel__body">
    <%# Greeting message %>
    <div class="mcp-msg mcp-msg--assistant">
      <span class="mcp-msg__avatar">AI</span>
      <span class="mcp-msg__bubble"><%%= simple_format(html_escape(greeting)) %></span>
    </div>
  </div>

  <%# Context bar — updated via turbo_stream %>
  <div id="mcp-context-bar" class="mcp-panel__context" style="display:none;">
    <%# Filled in by context_window partial after first message %>
  </div>

  <%# Input footer %>
  <div class="mcp-panel__footer">
    <%%= form_with url: mcp_chats_path, method: :post,
          data: { turbo: true, controller: "mcp-chat", action: "submit->mcp-chat#submit" },
          html: { class: "mcp-panel__form" } do |f| %>
      <%%= f.text_field :message, id: "mcp-chat-input",
            placeholder: "Ask anything…",
            autocomplete: "off",
            style: "flex:1;border:1px solid #d1d5db;border-radius:1.5rem;padding:0.45rem 0.9rem;font-size:0.875rem;outline:none;",
            data: { "mcp-chat-target": "input",
                    action: "keydown.enter->mcp-chat#submitOnEnter" } %>
      <button type="submit" class="mcp-panel__send" aria-label="Send">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </button>
    <%% end %>
  </div>
</div>

<%# ── Stimulus controller ── %>
<script>
(function() {
  // Minimal inline Stimulus-like controller for the chat widget.
  // If you use Stimulus in your app, replace this with a proper controller in
  // app/javascript/controllers/mcp_chat_controller.js
  document.addEventListener("DOMContentLoaded", function () {
    var panel = document.getElementById("mcp-panel");
    var msgs  = document.getElementById("mcp-chat-messages");
    var ctxBar = document.getElementById("mcp-context-bar");

    // Auto-scroll message list to bottom after Turbo updates
    document.addEventListener("turbo:after-stream-render", function () {
      if (msgs) msgs.scrollTop = msgs.scrollHeight;
      // Show context bar once it has content
      if (ctxBar && ctxBar.innerText.trim()) ctxBar.style.display = "";
      // Show typing indicator removal handled by turbo_stream replace
    });

    // Typing indicator on form submit
    var forms = document.querySelectorAll("form[action*='mcp_chats']");
    forms.forEach(function(form) {
      form.addEventListener("submit", function () {
        var typing = document.createElement("div");
        typing.id = "mcp-typing";
        typing.className = "mcp-msg mcp-msg--assistant";
        typing.innerHTML = '<span class="mcp-msg__avatar">AI</span>' +
          '<span class="mcp-msg__bubble mcp-typing">' +
          '<span></span><span></span><span></span></span>';
        if (msgs) {
          msgs.appendChild(typing);
          msgs.scrollTop = msgs.scrollHeight;
        }
        // Remove typing after Turbo replaces content
        document.addEventListener("turbo:after-stream-render", function remove() {
          var t = document.getElementById("mcp-typing");
          if (t) t.remove();
          document.removeEventListener("turbo:after-stream-render", remove);
        });
      });
    });
  });
})();
</script>
