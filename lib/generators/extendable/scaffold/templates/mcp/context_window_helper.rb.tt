# frozen_string_literal: true
# MCP Context Window helper — generated by extendable-rails.
#
# Include this module in controllers (or ApplicationController) that interact
# with LLM providers so your views can render the context-remaining UI.
#
# In a controller:
#
#   include Mcp::ContextWindowHelper
#
#   def ask
#     response = ExtendableRails::Mcp::Llm::ProviderManager.chat(
#       messages: [{ role: "user", content: params[:q] }]
#     )
#     record_usage(response, model: current_provider_model)
#   end
#
# In a view (after including the helper):
#
#   <%%= render "mcp/context_window", **context_summary %>
#
module Mcp
  module ContextWindowHelper
    include ExtendableRails::Mcp::ContextWindow

    # Expose summary to views automatically via a helper method.
    helper_method :context_summary,
                  :context_used_tokens,
                  :context_remaining_tokens,
                  :context_limit_tokens,
                  :context_remaining_percent,
                  :context_status if respond_to?(:helper_method)
  end
end
