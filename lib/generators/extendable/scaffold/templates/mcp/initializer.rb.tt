# frozen_string_literal: true
# MCP server configuration — generated by extendable-rails
#
# Mount in config/routes.rb:
#
#   mount Rails.application.config.mcp_server, at: "/mcp"
#
# To mount with authentication:
#
#   authenticated_mcp = Rack::Builder.new do
#     use Mcp::Middleware::Authentication
#     run Rails.application.config.mcp_server
#   end
#   mount authenticated_mcp, at: "/mcp"

require "mcp"

# ---------------------------------------------------------------------------
# ExtendableRails configuration
# ---------------------------------------------------------------------------
ExtendableRails.configure do |config|
  # --- Authentication ---
  # Strategy: :none (default), :api_key, or :oauth
  config.mcp_auth_strategy = :none

  # For :api_key strategy — set via Rails credentials or ENV
  # config.mcp_api_key = Rails.application.credentials.dig(:mcp, :api_key) || ENV["MCP_API_KEY"]

  # For :oauth strategy — token introspection endpoint
  # config.oauth_token_url = "https://your-auth-server.com/oauth/introspect"

  # --- LLM Providers (ordered by priority — first = primary, rest = fallbacks) ---
  # Uncomment and configure the providers you want to use.
  # When the primary provider fails or hits rate limits, the next one is tried.
  #
  # config.add_llm_provider(
  #   name:         :anthropic,
  #   api_key:      ENV["ANTHROPIC_API_KEY"],
  #   model:        "claude-sonnet-4-20250514",
  #   base_url:     "https://api.anthropic.com/v1/messages",  # optional
  #   max_failures: 3,                                        # circuit breaker threshold
  #   cooldown:     60                                        # seconds before retry
  # )
  #
  # config.add_llm_provider(
  #   name:     :gemini,
  #   api_key:  ENV["GEMINI_API_KEY"],
  #   model:    "gemini-2.0-flash"
  # )
  #
  # config.add_llm_provider(
  #   name:     :deepseek,
  #   api_key:  ENV["DEEPSEEK_API_KEY"],
  #   model:    "deepseek-chat"
  # )
  #
  # config.add_llm_provider(
  #   name:     :openai,
  #   api_key:  ENV["OPENAI_API_KEY"],
  #   model:    "gpt-4o"
  # )
end

# ---------------------------------------------------------------------------
# MCP Server
# ---------------------------------------------------------------------------
mcp_server = MCP::Server.new(
  name:    "#{Rails.application.class.module_parent_name.underscore.dasherize}-mcp",
  version: "1.0.0",
  tools:   []
)

Rails.application.config.mcp_server = mcp_server

# ---------------------------------------------------------------------------
# Auto-discover and register all MCP tools under app/mcp/tools/
# ---------------------------------------------------------------------------
Rails.application.config.after_initialize do
  tools_path = Rails.root.join("app", "mcp", "tools")
  if tools_path.exist?
    discovered = []
    Dir.glob(tools_path.join("**", "*_tool.rb")).sort.each do |file|
      # Derive the class name from the file path
      relative   = Pathname.new(file).relative_path_from(tools_path).to_s.delete_suffix(".rb")
      class_name = "Tools::#{relative.camelize}"

      begin
        klass = class_name.constantize

        # Register only concrete tool classes (skip ApplicationTool and BaseTool)
        if klass < MCP::Tool &&
           klass != Tools::ApplicationTool &&
           !klass.name&.end_with?("::BaseTool")
          discovered << klass
        end
      rescue NameError => e
        Rails.logger&.warn("[ExtendableRails] Could not load MCP tool #{class_name}: #{e.message}")
      end
    end
    Rails.application.config.mcp_server.tools = discovered
  end
end
