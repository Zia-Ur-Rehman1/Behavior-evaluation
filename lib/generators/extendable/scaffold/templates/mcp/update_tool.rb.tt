# frozen_string_literal: true

module Tools
  module <%= class_name.pluralize %>
    # Updates an existing <%= human_name.downcase %>.
    class UpdateTool < BaseTool
      tool_name "<%= singular_table_name %>_update"
      description "Update an existing <%= human_name.downcase %>"

      input_schema(
        properties: {
          id: { type: "integer", description: "The ID of the <%= human_name.downcase %> to update" },
<% mcp_attributes.each do |attr| -%>
          <%= attr.name %>: { type: "<%= mcp_type_for(attr) %>", description: "<%= attr.human_name %>" },
<% end -%>
        },
        required: ["id"]
      )

      class << self
        def call(id:, **attrs, server_context: nil)
          record = <%= class_name %>.find(id)
          permitted = attrs.slice(<%= mcp_attributes.map { |a| ":#{a.name}" }.join(", ") %>)
          record.update!(permitted)
          MCP::Tool::Response.new([{
            type: "text",
            text: record.to_json
          }])
        rescue ActiveRecord::RecordNotFound, ActiveRecord::RecordInvalid => e
          MCP::Tool::Response.new([{
            type: "text",
            text: JSON.generate({ error: e.message })
          }])
        end
      end
    end
  end
end
