# frozen_string_literal: true

require "mcp"

module Tools
  # Base class for all MCP tools in this application.
  # Generated by extendable-rails. Customize shared behavior here.
  #
  # Every model's BaseTool inherits from this class, so any logic you add
  # here (e.g. logging, authorization checks) applies to all tools.
  class ApplicationTool < MCP::Tool
  end
end
