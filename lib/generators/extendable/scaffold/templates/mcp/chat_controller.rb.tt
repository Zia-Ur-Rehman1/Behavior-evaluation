# frozen_string_literal: true
# MCP Chat Controller — generated by extendable-rails
#
# Handles the floating chat widget that lets users interact with the MCP
# LLM provider directly from any page.
#
# Routes (add to config/routes.rb):
#
#   resources :mcp_chats, only: [:create] do
#     collection { delete :clear }
#   end
#
class McpChatsController < ApplicationController
  include Mcp::ContextWindowHelper

  # Default system prompt — override MCP_CHAT_SYSTEM_PROMPT env var
  # or set Rails.application.config.mcp_chat_system_prompt in an initializer.
  DEFAULT_SYSTEM_PROMPT = <<~PROMPT.strip
    You are a helpful AI assistant embedded in this Rails application.
    You can help users find, create, update, and delete records through
    natural language. Available resources in this app:
    <%= mcp_tool_descriptions %>
    Always respond concisely and helpfully.
    If you cannot perform an action, explain why and suggest alternatives.
  PROMPT

  # POST /mcp_chats
  def create
    user_message = params[:message].to_s.strip
    return head(:bad_request) if user_message.blank?

    session[:mcp_messages] ||= []
    session[:mcp_messages] << { "role" => "user", "content" => user_message }

    begin
      response = ExtendableRails::Mcp::Llm::ProviderManager.chat(
        messages:   build_messages,
        max_tokens: 1024,
        system:     system_prompt
      )

      assistant_text = extract_text(response)
      record_usage(response, model: current_model_name)
      session[:mcp_messages] << { "role" => "assistant", "content" => assistant_text }

      @user_message      = user_message
      @assistant_message = assistant_text
      @context           = context_summary

      respond_to do |format|
        format.turbo_stream
        format.json { render json: { reply: assistant_text, context: @context } }
      end
    rescue ExtendableRails::Mcp::Llm::AllProvidersFailedError => e
      @error = "All AI providers are unavailable right now. Please try again later."
      Rails.logger.error("[McpChat] #{e.message}")
      respond_to do |format|
        format.turbo_stream { render :error }
        format.json { render json: { error: @error }, status: :service_unavailable }
      end
    end
  end

  # DELETE /mcp_chats/clear
  def clear
    session.delete(:mcp_messages)
    respond_to do |format|
      format.turbo_stream { render turbo_stream: turbo_stream.update("mcp-chat-messages", "") }
      format.html { redirect_back fallback_location: root_path }
    end
  end

  private

  def build_messages
    (session[:mcp_messages] || []).map do |msg|
      { role: msg["role"], content: msg["content"] }
    end
  end

  def system_prompt
    Rails.application.config.respond_to?(:mcp_chat_system_prompt) &&
      Rails.application.config.mcp_chat_system_prompt.present? ?
      Rails.application.config.mcp_chat_system_prompt :
      (ENV["MCP_CHAT_SYSTEM_PROMPT"] || DEFAULT_SYSTEM_PROMPT)
  end

  def current_model_name
    ExtendableRails.configuration.llm_providers.first&.dig(:model) || "unknown"
  end

  def extract_text(response)
    # Anthropic shape: { "content" => [{ "type" => "text", "text" => "..." }] }
    if (content = response["content"])
      return Array(content).select { |c| c["type"] == "text" }.map { |c| c["text"] }.join
    end
    # OpenAI / DeepSeek shape
    if (choice = response.dig("choices", 0))
      return choice.dig("message", "content").to_s
    end
    # Gemini shape
    if (parts = response.dig("candidates", 0, "content", "parts"))
      return parts.map { |p| p["text"] }.join
    end
    response.to_s
  end

  # Generates a human-readable list of registered MCP tools for the system prompt
  def self.mcp_tool_descriptions
    return "various resources" unless Rails.application.config.respond_to?(:mcp_server)

    tools = Rails.application.config.mcp_server.tools rescue []
    return "various resources" if tools.empty?

    tools.map { |t| "- #{t.tool_name}: #{t.description}" }.join("\n")
  rescue
    "various resources"
  end
end
