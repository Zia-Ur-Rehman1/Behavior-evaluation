<%%= form_with(model: <%= singular_table_name %>, style: "max-width:520px;") do |form| %>
  <%% if <%= singular_table_name %>.errors.any? %>
    <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:0.375rem;padding:0.75rem 1rem;margin-bottom:1rem;color:#b91c1c;">
      <strong><%%= pluralize(<%= singular_table_name %>.errors.count, "error") %> prevented this record from being saved:</strong>
      <ul style="margin:0.25rem 0 0 1.25rem;">
        <%% <%= singular_table_name %>.errors.each do |error| %>
          <li><%%= error.full_message %></li>
        <%% end %>
      </ul>
    </div>
  <%% end %>

<% attributes.each do |attribute| -%>
  <div style="margin-bottom:0.75rem;">
    <%%= form.label :<%= attribute.column_name %>, style: "display:block;font-weight:600;margin-bottom:0.25rem;font-size:0.875rem;" %>
<% if attribute.type == :text -%>
    <%%= form.text_area :<%= attribute.column_name %>, style: "width:100%;border:1px solid #d1d5db;border-radius:0.375rem;padding:0.4rem 0.6rem;font-size:0.875rem;" %>
<% elsif attribute.type == :boolean -%>
    <%%= form.check_box :<%= attribute.column_name %> %>
<% elsif attribute.type == :date -%>
    <%%= form.date_field :<%= attribute.column_name %>, style: "border:1px solid #d1d5db;border-radius:0.375rem;padding:0.4rem 0.6rem;" %>
<% elsif attribute.type == :datetime -%>
    <%%= form.datetime_field :<%= attribute.column_name %>, style: "border:1px solid #d1d5db;border-radius:0.375rem;padding:0.4rem 0.6rem;" %>
<% elsif attribute.type == :integer || attribute.type == :float || attribute.type == :decimal -%>
    <%%= form.number_field :<%= attribute.column_name %>, style: "width:100%;border:1px solid #d1d5db;border-radius:0.375rem;padding:0.4rem 0.6rem;" %>
<% else -%>
    <%%= form.text_field :<%= attribute.column_name %>, style: "width:100%;border:1px solid #d1d5db;border-radius:0.375rem;padding:0.4rem 0.6rem;font-size:0.875rem;" %>
<% end -%>
  </div>

<% end -%>
  <%%= form.submit style: "background:#3b82f6;color:#fff;padding:0.4rem 1.25rem;border:none;border-radius:0.375rem;cursor:pointer;font-size:0.875rem;" %>
<%% end %>
