<%%= form_with(model: <%= singular_table_name %>) do |form| %>
  <%% if <%= singular_table_name %>.errors.any? %>
    <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:0.5rem;padding:0.75rem 1rem;margin-bottom:1rem;color:#b91c1c;">
      <strong><%%= pluralize(<%= singular_table_name %>.errors.count, "error") %>:</strong>
      <ul style="margin:0.25rem 0 0 1.25rem;">
        <%% <%= singular_table_name %>.errors.each do |error| %>
          <li><%%= error.full_message %></li>
        <%% end %>
      </ul>
    </div>
  <%% end %>

  <div style="border:1px solid #e5e7eb;border-radius:0.75rem;overflow:hidden;max-width:520px;">
    <div style="padding:1rem 1.25rem;">
<% attributes.each do |attribute| -%>
      <div style="margin-bottom:0.875rem;">
        <%%= form.label :<%= attribute.column_name %>, style: "display:block;font-size:0.8rem;font-weight:600;color:#374151;margin-bottom:0.25rem;" %>
<% if attribute.type == :text -%>
        <%%= form.text_area :<%= attribute.column_name %>, rows: 3,
              style: "width:100%;border:1px solid #d1d5db;border-radius:0.5rem;padding:0.5rem 0.75rem;font-size:0.875rem;resize:vertical;" %>
<% elsif attribute.type == :boolean -%>
        <%%= form.check_box :<%= attribute.column_name %>, style: "width:1rem;height:1rem;" %>
<% elsif attribute.type == :date -%>
        <%%= form.date_field :<%= attribute.column_name %>,
              style: "border:1px solid #d1d5db;border-radius:0.5rem;padding:0.5rem 0.75rem;" %>
<% elsif attribute.type == :datetime -%>
        <%%= form.datetime_field :<%= attribute.column_name %>,
              style: "border:1px solid #d1d5db;border-radius:0.5rem;padding:0.5rem 0.75rem;" %>
<% elsif attribute.type == :integer || attribute.type == :float || attribute.type == :decimal -%>
        <%%= form.number_field :<%= attribute.column_name %>,
              style: "width:100%;border:1px solid #d1d5db;border-radius:0.5rem;padding:0.5rem 0.75rem;" %>
<% else -%>
        <%%= form.text_field :<%= attribute.column_name %>,
              style: "width:100%;border:1px solid #d1d5db;border-radius:0.5rem;padding:0.5rem 0.75rem;font-size:0.875rem;" %>
<% end -%>
      </div>
<% end -%>
    </div>
    <div style="padding:0.75rem 1.25rem;border-top:1px solid #e5e7eb;background:#f9fafb;">
      <%%= form.submit style: "background:#3b82f6;color:#fff;padding:0.45rem 1.25rem;border:none;border-radius:0.5rem;cursor:pointer;font-size:0.875rem;font-weight:600;" %>
    </div>
  </div>
<%% end %>
