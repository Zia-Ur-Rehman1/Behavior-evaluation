<%%= turbo_frame_tag dom_id(<%= singular_table_name %>) do %>
  <li id="<%%= dom_id(<%= singular_table_name %>) %>">
<% attributes.reject(&:password_digest?).each_with_index do |attribute, i| -%>
<% if i == 0 -%>
    <strong><%%= <%= singular_table_name %>.<%= attribute.column_name %> %></strong>
<% else -%>
    — <%%= <%= singular_table_name %>.<%= attribute.column_name %> %>
<% end -%>
<% end -%>
    <%%= link_to "[show]", <%= singular_table_name %> %>
    <%%= link_to "[edit]", edit_<%= singular_table_name %>_path(<%= singular_table_name %>) %>
    <%%= button_to "[del]", <%= singular_table_name %>, method: :delete,
          data: { turbo_confirm: "Delete?" },
          style:"background:none;border:none;color:red;cursor:pointer;padding:0;" %>
  </li>
<%% end %>
