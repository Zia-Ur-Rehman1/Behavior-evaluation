<p style="color: green"><%%= notice %></p>

<%%= turbo_frame_tag dom_id(@<%= singular_table_name %>) do %>
  <%%= render @<%= singular_table_name %> %>
<%% end %>

<div>
  <%%= link_to "Edit <%= human_name %>", edit_<%= singular_table_name %>_path(@<%= singular_table_name %>) %> |
  <%%= link_to "Back to <%= human_name.pluralize %>", <%= index_helper %>_path %>
  <%%= button_to "Delete <%= human_name %>", @<%= singular_table_name %>, method: :delete,
        data: { turbo_confirm: "Are you sure you want to delete this <%= human_name.downcase %>?" } %>
</div>
