<p style="color: green"><%= notice %></p>

<%= turbo_frame_tag dom_id(@report) do %>
  <%= render @report %>
<% end %>

<div>
  <%= link_to "Edit Report", edit_report_path(@report) %> |
  <%= link_to "Back to Reports", reports_path %>
  <%= button_to "Delete Report", @report, method: :delete,
        data: { turbo_confirm: "Are you sure you want to delete this report?" } %>
</div>
