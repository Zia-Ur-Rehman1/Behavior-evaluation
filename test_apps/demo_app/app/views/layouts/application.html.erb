<!DOCTYPE html>
<html>
  <head>
    <title>DemoApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>

    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; margin: 0; padding: 0; background: #f9fafb; color: #111827; }
      .navbar { background: #1e293b; padding: 0.75rem 1.5rem; display: flex; align-items: center; gap: 1.5rem; }
      .navbar a { color: #cbd5e1; text-decoration: none; font-size: 0.9rem; transition: color 0.15s; }
      .navbar a:hover { color: #fff; }
      .navbar .app-name { color: #fff; font-weight: 700; font-size: 1.1rem; margin-right: 1rem; }
      .navbar .nav-links { display: flex; gap: 1rem; flex: 1; }
      .navbar .user-info { color: #94a3b8; font-size: 0.85rem; display: flex; align-items: center; gap: 0.75rem; }
      .navbar .user-info strong { color: #e2e8f0; }
      .navbar .logout-btn { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #e2e8f0; padding: 0.3rem 0.75rem; border-radius: 0.375rem; font-size: 0.8rem; cursor: pointer; }
      .navbar .logout-btn:hover { background: rgba(255,255,255,0.2); }
      .flash { padding: 0.75rem 1.5rem; font-size: 0.9rem; }
      .flash-notice { background: #ecfdf5; color: #065f46; border-bottom: 1px solid #a7f3d0; }
      .flash-alert { background: #fef2f2; color: #991b1b; border-bottom: 1px solid #fecaca; }
      .main-content { padding: 1.5rem; max-width: 1200px; margin: 0 auto; }
    </style>
  </head>

  <body>
    <% if current_user %>
      <nav class="navbar">
        <span class="app-name">DemoApp</span>
        <div class="nav-links">
          <%= link_to "Products", products_path %>
          <%= link_to "Articles", articles_path %>
          <%= link_to "Reports", reports_path %>
        </div>
        <div class="user-info">
          <span>Signed in as <strong><%= current_user.name %></strong> (<%= current_user.role %>)</span>
          <%= button_to "Logout", logout_path, method: :delete, class: "logout-btn" %>
        </div>
      </nav>
    <% end %>

    <% if flash[:notice] %>
      <div class="flash flash-notice"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="flash flash-alert"><%= flash[:alert] %></div>
    <% end %>

    <div class="main-content">
      <%= yield %>
    </div>

    <% if current_user&.can_use_mcp? %>
      <%= render "mcp/chat_widget" %>
    <% end %>
  </body>
</html>
