<%# MCP Context Window UI — generated by extendable-rails
    Include in any layout or view that should show LLM context usage:

      <%= render "mcp/context_window",
            used:      context_used_tokens,
            remaining: context_remaining_tokens,
            limit:     context_limit_tokens,
            percent:   context_remaining_percent,
            status:    context_status,
            model:     @mcp_model %>

    Or pass a summary hash directly:
      <%= render "mcp/context_window", **context_summary %>
-%>

<%
  used      = local_assigns.fetch(:used,      0)
  remaining = local_assigns.fetch(:remaining, 0)
  limit     = local_assigns.fetch(:limit,     128_000)
  percent   = local_assigns.fetch(:percent,   100.0)
  status    = local_assigns.fetch(:status,    :ok)
  model     = local_assigns.fetch(:model,     nil)

  bar_color = case status
              when :ok       then "#22c55e"   # green-500
              when :warning  then "#f59e0b"   # amber-500
              when :critical then "#ef4444"   # red-500
              else                "#6b7280"   # gray-500
              end

  bar_width = [[percent, 0].max, 100].min
%>

<div class="mcp-context-window" style="font-family: system-ui, sans-serif; font-size: 0.85rem; color: #374151; border: 1px solid #e5e7eb; border-radius: 0.5rem; padding: 0.75rem 1rem; background: #f9fafb; max-width: 420px;">
  <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.35rem;">
    <span style="font-weight: 600;">Context Window</span>
    <% if model %>
      <span style="color: #6b7280; font-size: 0.75rem;"><%= model %></span>
    <% end %>
  </div>

  <%# Progress bar %>
  <div style="background: #e5e7eb; border-radius: 9999px; height: 8px; overflow: hidden; margin-bottom: 0.4rem;">
    <div style="background: <%= bar_color %>; width: <%= bar_width %>%; height: 100%; border-radius: 9999px; transition: width 0.3s ease;"></div>
  </div>

  <%# Token counts %>
  <div style="display: flex; justify-content: space-between;">
    <span>
      <strong style="color: <%= bar_color %>;"><%= number_with_delimiter(remaining) %></strong>
      tokens remaining
    </span>
    <span style="color: #9ca3af;">
      <%= number_with_delimiter(used) %> / <%= number_with_delimiter(limit) %> used
    </span>
  </div>

  <% if status == :warning %>
    <p style="margin: 0.4rem 0 0; color: #b45309; font-size: 0.75rem;">
      &#9888; Context window is getting full. Consider starting a new conversation.
    </p>
  <% elsif status == :critical %>
    <p style="margin: 0.4rem 0 0; color: #b91c1c; font-size: 0.75rem;">
      &#9888; Critical: less than 10&nbsp;% of context remaining. Start a new conversation soon.
    </p>
  <% end %>
</div>
