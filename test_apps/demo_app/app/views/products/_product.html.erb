<%= turbo_frame_tag dom_id(product) do %>
  <div id="<%= dom_id(product) %>">
    <p>
      <strong>Name:</strong>
      <%= product.name %>
    </p>
    <p>
      <strong>Price:</strong>
      <%= product.price %>
    </p>
    <p>
      <strong>Description:</strong>
      <%= product.description %>
    </p>

    <p>
      <%= link_to "Edit", edit_product_path(product) %> |
      <%= button_to "Delete", product, method: :delete,
            data: { turbo_confirm: "Are you sure?" } %>
    </p>
  </div>
<% end %>
