# frozen_string_literal: true

source "https://rubygems.org"

gemspec path: ".."

# Rails 5.2 was designed for Ruby 2.5–2.7. On Ruby 3.1+ it needs a few
# compatibility gems pinned to avoid stdlib removals.
gem "rails",   "~> 5.2.8"
gem "sqlite3", "~> 1.4.0"

# Ruby 3.1+ removed these from stdlib default gems; Rails 5 assumed them.
gem "logger"
gem "mutex_m"
gem "bigdecimal"
gem "drb"
gem "base64"

# Pin concurrent-ruby; 1.3.5 removed the Logger autoload hack Rails 5 relied on.
gem "concurrent-ruby", "1.3.4"

group :development, :test do
  gem "rspec", ">= 3.12"
  gem "generator_spec"
end
